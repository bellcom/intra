    "repositories": {
        "os2core": {
            "type": "vcs",
            "url": "git@github.com:bellcom/os2core.git"
        },
        "0": {
            "type": "composer",
            "url": "https://packages.drupal.org/8",
            "exclude": [
                "drupal/anonymous_subscriptions"
            ]
        },
        "1": {
            "type": "vcs",
            "url": "https://github.com/bellcom/fds_base_theme"
        },
        "2": {
            "type": "package",
