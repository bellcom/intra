{% include '@fds_fredericia_intra_theme/includes/header.html.twig' %}



<div class="page-container {% if is_front %} page-container-front {% else %} page-container-not-front {% endif %}">
  <div class="container" id="main-content" role="main">
    {{ page.highlighted }}

    <div class="layout--hidden-on-sections">


      {# Sidebars are disabled on the front page for the intranet theme. #}
      {% set has_sidebar_first = not is_front and page.sidebar_first|render|striptags("<drupal-render-placeholder>")|trim is not empty %}
      {% set has_sidebar_second = not is_front and page.sidebar_second|render|striptags("<drupal-render-placeholder>")|trim is not empty %}
      {% set has_main_content = page.content|render|striptags("<drupal-render-placeholder>")|trim is not empty %}

      {%
        set content_classes = [
          has_sidebar_first and has_sidebar_second ? 'col-md-4 content-column',
          has_sidebar_first is empty and has_sidebar_second  ? 'col-lg-8 content-column',
          has_sidebar_first and has_sidebar_second is empty ? 'col-lg-8 content-column',
          not has_sidebar_first and not has_sidebar_second ? 'content-column',
        ]
      %}

      {% if has_sidebar_first %}
        {% block sidebar_first %}
          <aside class="col-lg-4 sidebar-column">
            <div class="layout-sidebar-left">
              {{ page.sidebar_first }}
            </div>
          </aside>
        {% endblock %}
      {% endif %}
      {% if has_main_content %}
        <main {{ content_attributes.addClass(content_classes) }}>
          <div class="layout-content">
            {{ page.content }}
          </div>
        </main>
      {% endif %}
      {% if has_sidebar_second %}
        {% block sidebar_second %}
          <aside class="col-lg-4 sidebar-column">
            <div class="layout-sidebar-right">
              {{ page.sidebar_second }}
            </div>
          </aside>
        {% endblock %}
      {% endif %}

    </div>

  </div>

  {{ page.featured_bottom_first }}
</div>

{% include '@fds_fredericia_main_theme/includes/footer.html.twig' %}

{{ page.embedded_code }}
