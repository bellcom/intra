   /**
+   * Build verified source links from the source IDs selected by the LLM.
+   */
+  private function buildSourcesHtml(
+    string $response,
+    array $source_links,
+  ): string {
+    if (!preg_match('/<!--\s*SOURCES:\s*([^>]*)-->/i', $response, $matches)) {
+      return '';
+    }
+
+    $raw_ids = trim($matches[1]);
+    if ($raw_ids === '') {
+      return '';
+    }
+
+    $links = [];
+    foreach (explode(',', $raw_ids) as $raw_id) {
+      $source_id = trim($raw_id);
+      if ($source_id === '' || !isset($source_links[$source_id])) {
+        continue;
+      }
+      $links[$source_id] = $source_links[$source_id];
+    }
+
+    if ($links === []) {
+      return '';
+    }
+
+    return "\n<h3>Kilder</h3>\n<ul>\n" .
+      implode("\n", $links) .
+      "\n</ul>";
+  }
+
+  /**
+   * Remove the internal source-selection marker from an LLM response.
+   */
+  private function stripSourceMarker(string $response): string {
+    return preg_replace(
+      '/<!--\s*SOURCES:\s*[^>]*-->/i',
+      '',
+      $response,
+    ) ?? $response;
+  }
+
+  /**
+   * Finish a non-streamed response with verified source links.
+   */
+  private function finalizeResponse(
+    string $response,
+    array $source_links,
+  ): string {
+    $sources_html = $this->buildSourcesHtml($response, $source_links);
+    $response = $this->stripSourceMarker($response);
+
+    return rtrim($response) . $sources_html . "\n";
+  }
