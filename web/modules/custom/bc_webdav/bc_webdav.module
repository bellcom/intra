<?php

use Drupal\Core\File\FileSystemInterface;
use Drupal\Core\File\FileExists;
use Drupal\file\IconMimeTypes;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Form\FormStateInterface;
use Symfony\Component\HttpFoundation\Response;
use Drupal\Core\Link;


function bc_webdav_theme($existing, $type, $theme, $path) {
  return array(
    'file_link_webdav' => array(
      'template' => 'file-link-webdav',
      'base hook' => 'file link'
    ),
  );

}


function bc_webdav_page_attachments(array &$page) {
  $page['#attached']['library'][] = 'bc_webdav/webdav-styling';
}


function bc_webdav_theme_suggestions_alter(array &$suggestions, array &$variables, $hook) {

  if ($hook === 'file_link') {

    $node = \Drupal::routeMatch()->getParameter('node');
    if ($node instanceof \Drupal\node\NodeInterface && $node->bundle() == 'group_file') {
      if ($node->hasField('field_webdav') && $node->get('field_webdav')->value) {

        $file = $variables['file'];

        $mime_type = strtr($file->getMimeType(), ['/' => '-', '.' => '-']);

        $icon_classes = array(
          'file',
          'file--mime-' . $mime_type,
          'file--' . IconMimeTypes::getIconClass($file->getMimeType()),
          'webdav-file-link'
        );
        $variables['icon_classes'] = $icon_classes;

        $options = [];
        $options['attributes']['type'] = $file->getMimeType();

        if (empty($variables['description'])) {
          $link_text = $file->getFilename();

        } else {
          $link_text = $variables['description'];
          $options['attributes']['title'] = $file->getFilename();
        }

        $variables['link_text'] = $link_text;

        $file_url_generator = \Drupal::service('file_url_generator');
        $url = $file_url_generator->generate($file->getFileUri());
        $link = Link::fromTextAndUrl($link_text, $url->mergeOptions($options))->toRenderable();

        $variables['link'] = $link;

        $buttons = '<div class="webdav-buttons">';
        $buttons .= '<div class="webdav-button webdav-download" data-action="download" data-link="" data-id="' . $file->uuid() . '" title="download"></div>';
        $buttons .= '<div class="webdav-button webdav-view" data-action="view" data-link="" data-id="' . $file->uuid() . '" title="view"></div>';
        $buttons .= '<div class="webdav-button webdav-edit" data-action="edit" data-link="" data-id="' . $file->uuid() . '" data-locked="" title="edit"></div>';
        $buttons .= '<div class="webdav-button webdav-history" data-action="history" data-link="" data-id="' . $file->uuid() . '" title="history"></div>';
        $buttons .= '<iframe id="webdavframe" src="/webdavhandler" style="display:none"></iframe>';
        $buttons .= '</div>';

        $variables['buttons'] = array(
          '#type' => 'inline_template',
          '#template' => $buttons
        );

        $suggestions = array($hook . '_' . 'webdav');
      }
    }
  }
}


/**
 * Short grace period while Office/LibreOffice starts and obtains its DAV lock.
 */
const BC_WEBDAV_LOCK_START_GRACE = 15;

/**
 * Old orphan cleanup timeout.
 */
const BC_WEBDAV_ORPHAN_TIMEOUT = 1800;

/**
 * Return current WebDAV lock state for a working file.
 *
 * Possible values:
 * - locked
 * - unlocked
 * - unknown
 */
function bc_webdav_get_lock_state($config, string $file_name): string {
  $base_url = trim((string) $config->get('url'));

  if ($base_url === '') {
    return 'unknown';
  }

  $url = rtrim($base_url, '/') . '/' . rawurlencode($file_name);

  $options = [
    'headers' => [
      'Depth' => '0',
      'Content-Type' => 'application/xml; charset=utf-8',
    ],
    'body' => '<?xml version="1.0" encoding="utf-8"?>'
      . '<D:propfind xmlns:D="DAV:">'
      . '<D:prop><D:lockdiscovery/></D:prop>'
      . '</D:propfind>',
    'http_errors' => FALSE,
    'allow_redirects' => FALSE,
    'connect_timeout' => 3,
    'timeout' => 5,
  ];

  // Server-side lock discovery may use the shared WebDAV account.
  // This is independent of what authentication method desktop clients use.
  $username = trim(
    (string) \Drupal::state()->get('bc_webdav.webdav_username', '')
  );

  $password = (string) \Drupal::state()
    ->get('bc_webdav.webdav_password', '');

  if ($username !== '' && $password !== '') {
    $options['auth'] = [$username, $password];
  }

  try {
    $response = \Drupal::httpClient()
      ->request('PROPFIND', $url, $options);
  }
  catch (\Throwable $e) {
    \Drupal::logger('bc_webdav')->warning(
      'WebDAV lock discovery failed for @file: @message',
      [
        '@file' => $file_name,
        '@message' => $e->getMessage(),
      ]
    );

    return 'unknown';
  }

  if (!in_array($response->getStatusCode(), [200, 207], TRUE)) {
    return 'unknown';
  }

  $body = (string) $response->getBody();

  if (
    preg_match(
      '/<(?:[A-Za-z_][A-Za-z0-9_.-]*:)?activelock(?:\s|>)/i',
      $body
    )
  ) {
    return 'locked';
  }

  return 'unlocked';
}

/**
 * Import a finished WebDAV working copy into Drupal.
 */
function bc_webdav_import_working_file(string $filename): bool {
  if (!is_file($filename)) {
    return FALSE;
  }

  $base = basename($filename);
  $dir = dirname($filename);
  $sidecar = $dir . '/id.' . $base;

  if (!is_file($sidecar)) {
    return FALSE;
  }

  $metadata = trim((string) file_get_contents($sidecar));

  if (!preg_match('/^(\d+):(\d+)$/', $metadata, $matches)) {
    return FALSE;
  }

  $fid = (int) $matches[1];
  $uid = (int) $matches[2];

  if ($fid <= 0) {
    return FALSE;
  }

  $file = \Drupal::entityTypeManager()
    ->getStorage('file')
    ->load($fid);

  if (!$file || $file->getFilename() !== $base) {
    return FALSE;
  }

  $data = file_get_contents($filename);

  if ($data === FALSE) {
    return FALSE;
  }

  try {
    $repository = \Drupal::service('file.repository');

    $result = $repository->writeData(
      $data,
      $file->getFileUri(),
      FileExists::Replace
    );

    $result->save();
  }
  catch (\Throwable $e) {
    \Drupal::logger('bc_webdav')->error(
      'Could not import WebDAV file @file: @message',
      [
        '@file' => $base,
        '@message' => $e->getMessage(),
      ]
    );

    return FALSE;
  }

  if (is_file($filename) && !unlink($filename)) {
    return FALSE;
  }

  if (is_file($sidecar) && !unlink($sidecar)) {
    return FALSE;
  }

  try {
    \Drupal::database()
      ->insert('bc_webdav_log')
      ->fields([
        'fid' => $fid,
        'uid' => $uid,
        'action' => 'update',
      ])
      ->execute();
  }
  catch (\Throwable $e) {
    \Drupal::logger('bc_webdav')->warning(
      'File @file was imported but history logging failed: @message',
      [
        '@file' => $base,
        '@message' => $e->getMessage(),
      ]
    );
  }

  return TRUE;
}

/**
 * Implements hook_cron().
 */
function bc_webdav_cron() {
  $config = \Drupal::config('bc_webdav.settings');

  if (!$config->get('enabled') || !$config->get('folder')) {
    return;
  }

  $folder = rtrim((string) $config->get('folder'), '/');

  if (!is_dir($folder)) {
    return;
  }

  foreach (glob($folder . '/*') ?: [] as $filename) {
    if (!is_file($filename)) {
      continue;
    }

    $base = basename($filename);

    if (str_starts_with($base, 'id.')) {
      continue;
    }

    $sidecar = $folder . '/id.' . $base;

    // Orphaned working file without session metadata:
    // retain the old 30 minute cleanup as failsafe.
    if (!is_file($sidecar)) {
      $mtime = filemtime($filename);

      if (
        $mtime !== FALSE
        && time() >= ($mtime + BC_WEBDAV_ORPHAN_TIMEOUT)
      ) {
        unlink($filename);
      }

      continue;
    }

    $started = filemtime($sidecar);

    if ($started === FALSE) {
      continue;
    }

    $age = max(0, time() - $started);

    $lock_state = bc_webdav_get_lock_state(
      $config,
      $base
    );

    // Office/LibreOffice still owns the file.
    if ($lock_state === 'locked') {
      continue;
    }

    // Never import when the server could not determine lock state.
    if ($lock_state === 'unknown') {
      continue;
    }

    // Prevent race between Drupal creating the file and the desktop client
    // obtaining its initial DAV LOCK.
    if ($age < BC_WEBDAV_LOCK_START_GRACE) {
      continue;
    }

    // DAV server answered successfully and no active lock exists.
    bc_webdav_import_working_file($filename);
  }
}
