{% include '@fds_fredericia_intra_theme/includes/header.html.twig' %}

<div class="page-container {% if is_front %} page-container-front {% else %} page-container-not-front {% endif %}">
  <div class="container" id="main-content" role="main">
    {{ page.highlighted }}

    {% set has_main_content = page.content|render|striptags("<drupal-render-placeholder>")|trim is not empty %}

    {% if is_front %}
      {# Front page: keep current full-width structure, no sidebars. #}
      <div class="layout--hidden-on-sections">
        {% if has_main_content %}
          <main {{ content_attributes.addClass('content-column') }}>
            <div class="layout-content">
              {{ page.content }}
            </div>
          </main>
        {% endif %}
      </div>
    {% else %}
      {# Content pages: Midtpunktet sidebar / main content proportions. #}
      {% set has_sidebar_first = page.sidebar_first|render|striptags("<drupal-render-placeholder>")|trim is not empty %}
      {% set has_sidebar_second = page.sidebar_second|render|striptags("<drupal-render-placeholder>")|trim is not empty %}

      {% if has_main_content %}
        <div class="row row-no-flex layout--hidden-on-sections">
          {% set sidebar_first_classes = [
            has_sidebar_first and has_sidebar_second ? 'col-12 col-md-3 sidebar-first',
            has_sidebar_first and not has_sidebar_second ? 'sideblock-venstre d-print-none',
          ] %}
          {% if has_sidebar_first %}
            <aside class="{{ sidebar_first_classes|join(' ') }}">
              <div class="layout-sidebar-left">
                {{ page.sidebar_first }}
              </div>
            </aside>
          {% endif %}

          {% set content_classes = [
            has_sidebar_first and has_sidebar_second ? 'col-12 col-md-6 content-main',
            has_sidebar_first and not has_sidebar_second ? 'hovedindhold-hojre',
            has_sidebar_second and not has_sidebar_first ? 'hovedindhold-venstre',
            not has_sidebar_first and not has_sidebar_second ? 'content-main',
          ] %}
          <main {{ content_attributes.addClass(content_classes) }}>
            <div class="layout-content">
              {{ page.content }}
            </div>
          </main>

          {% set sidebar_second_classes = [
            has_sidebar_first and has_sidebar_second ? 'col-12 col-md-3 sidebar-second',
            not has_sidebar_first and has_sidebar_second ? 'sideblock-hojre d-print-none',
          ] %}
          {% if has_sidebar_second %}
            <aside class="{{ sidebar_second_classes|join(' ') }}">
              <div class="layout-sidebar-right">
                <div class="box">
                  <div class="box__body">
                    {{ page.sidebar_second }}
                  </div>
                </div>
              </div>
            </aside>
          {% endif %}
        </div>
      {% endif %}
    {% endif %}

  </div>

  {{ page.featured_bottom_first }}
</div>

{% include '@fds_fredericia_main_theme/includes/footer.html.twig' %}

{{ page.embedded_code }}
