{% set classes = [
  "flag-sidebar-block",
] %}

{% if config.enabled %}

<div{{ attributes.addClass(classes) }}>

  {% if config.bookmark %}
  <div class="sidebar-block sidebar-bookmark">
    <div class="sidebar-bookmark-icon"><img src="/modules/custom/bc_flag_extension/images/star.png"></div>
    <div class="sidebar-bookmark-list">
      <div class="headline">Mine bogmærker</div>
      <ul class="sidebar-bookmark-list-ul"></ul>
    </div>
  </div>
  {% endif %}

  {% if config.shortcut %}
  <div class="sidebar-block sidebar-shortcut">
    <div class="sidebar-shortcut-icon"><img src="/modules/custom/bc_flag_extension/images/shortcut.png"></div>
    <div class="sidebar-shortcut-list">
      <div class="headline">Smutveje</div>
      <ul class="sidebar-shortcut-list-ul"></ul>
    </div>
  </div>
  {% endif %}

  {% if config.unread %}
  <div class="sidebar-block sidebar-unread">
    <div class="sidebar-unread-icon"><img src="/modules/custom/bc_flag_extension/images/bell.png"></div>
    <div class="sidebar-unread-list">
      <div class="headline">Du har <span class="unread-number">0</span> ulæste beskeder</div>
      <ul class="sidebar-unread-list-ul"></ul>
    </div>
  </div>
  {% endif %}

</div>

{% endif %}
