{#
/**
 * @file
 * Template override to display the os2web_reference_menu paragraph.
 *
 * Available variables:
 * - menu: A render array representing the menu.
 *
 * @see YOURTHEME_preprocess_paragraph__os2web_reference_menu()
 */
#}
<div class="menu-reference-wrapper">
  <div class="paragraph-menu-header">
    <h2>{{ content.field_menu_reference_heading }}</h2>
  </div>
  {{ menu }}
</div>

<script>

  document.querySelectorAll('.menu-reference-wrapper .menu-item--expanded').forEach(item => {
    // Create a button element
    const btn = document.createElement('button');
    btn.innerText = '+'; // Initially set to '+'
    btn.addEventListener('click', () => {
      // Find the nested <ul> and toggle its visibility
      const subMenu = item.querySelector('ul');
      if (subMenu.style.display === 'none' || subMenu.style.display === '') {
        subMenu.style.display = 'block';
        btn.innerText = '-'; // Set to '-' when expanded
      } else {
        subMenu.style.display = 'none';
        btn.innerText = '+'; // Set back to '+' when collapsed
      }
    });
    // Find the <a> tag and insert the button before it
    const aTag = item.querySelector('a');
    aTag.insertAdjacentElement('beforebegin', btn);
  });

</script>
