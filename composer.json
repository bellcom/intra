    "require-dev": {
        "drupal/core-dev": "^11.4"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/console-extend-plugin": false,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "simplesamlphp/composer-module-installer": false,
            "tbachert/spi": true,
            "zaporylie/composer-drupal-optimizations": true,
            "symfony/runtime": true
        }
    },
    "autoload": {
        "classmap": [
            "scripts/composer/ScriptHandler.php"
        ],
        "files": [
            "load.environment.php"
        ]
    },
    "scripts": {
        "pre-install-cmd": [
            "DrupalProject\\composer\\ScriptHandler::checkComposerVersion"
        ],
        "pre-update-cmd": [
            "DrupalProject\\composer\\ScriptHandler::checkComposerVersion"
        ],
        "post-install-cmd": [
            "DrupalProject\\composer\\ScriptHandler::createRequiredFiles"
        ],
        "post-update-cmd": [
            "DrupalProject\\composer\\ScriptHandler::createRequiredFiles"
        ]
    },
    "extra": {
        "composer-exit-on-patch-failure": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ]
        },
        "enable-patching": true,
        "patches": {
            "drupal/core": {
                "Provide a way for fields with computed or custom storage to decide how to impact entity queries.": "https://www.drupal.org/files/issues/2021-12-06/3025164-33.patch"
            },
            "drupal/facets": {
                "Add option to reset other facets on value change": "https://www.drupal.org/files/issues/2023-01-25/3190289-22-reroll.patch"
            },
            "drupal/flag_anon": {
                "Flag 4 build method signature compatibility": "./patches/flag_anon-flag4-build-signature.patch"
            },
            "os2web/os2web_hjemmeside": {
                "Remove unused os2web_borgerdk dependency": "./patches/os2web_hjemmeside-remove-borgerdk-dependency.patch"
            },
            "drupal/media_directories": {
                "Allow Media Directories Browser on Drupal 10.2+": "./patches/media_directories-browser-drupal10.patch"
            },
            "drupal/user_delete_reassign": {
                "Drupal 11 compatibility from upstream MR !6": "./patches/user_delete_reassign-drupal11-mr6.patch",
                "Drupal 11 follow-up: preserve role filtering and use NodeBulkUpdate": "./patches/user_delete_reassign-drupal11-followup.patch"
            },
            "drupal/file_management": {
                "Drupal 11 and PHP 8.4 compatibility": "./patches/file_management-drupal11.patch"
            },
            "drupal/popular_search_keywords": {
                "Drupal 11 compatibility": "./patches/popular_search_keywords-drupal11.patch"
            },
            "drupal/anonymous_subscriptions": {
                "Drupal 11 and PHP 8.4 compatibility": "./patches/anonymous_subscriptions-drupal11-php84.patch",
                "Drupal 11 ConfigFormBase typed config manager compatibility": "./patches/anonymous_subscriptions-drupal11-settingsform.patch"
            },
            "bellcom/fds_base_theme": {
                "Drupal 11 compatibility": "./patches/fds_base_theme-drupal11.patch"
            },
            "drupal/search_api_synonym": {
                "Remove obsolete Drupal Console command for Drupal 11": "./patches/search_api_synonym-remove-drupal-console.patch"
            }
        }
    }
}
